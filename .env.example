# M12 â€” plantilla de entorno para `docker compose`. Copiar a `.env` y completar.
# NUNCA versionar valores reales: `.env` estÃ¡ en .gitignore/.dockerignore.

# --- PostgreSQL (servicio `db`) ---
POSTGRES_USER=privacy
POSTGRES_PASSWORD=privacy-dev-only
POSTGRES_DB=privacy

# M21.9 - credenciales DEV-ONLY de los roles de aplicacion. Deben coincidir con
# los `ALTER ROLE ... PASSWORD` de la migracion 0018_rls_tenant_policies. En
# produccion: `ALTER ROLE ... PASSWORD '<secreto>'` + setear aqui el valor real.
APP_ROLE_PASSWORD=app-role-dev-only
BG_ROLE_PASSWORD=bg-role-dev-only

# --- API (servicio `api`) ---
NODE_ENV=production
API_PORT=5000
# Generar con: openssl rand -base64 48
JWT_SECRET=
# >= 32 caracteres; cifra credenciales de fuentes (fail-fast en producciÃ³n)
SOURCE_ENCRYPTION_KEY=
# Misma origin por defecto (nginx proxea /api). Solo definir si el frontend
# llama a la API desde otro origen.
CORS_ORIGINS=
# La API corre tras nginx/compose: confiar en un solo salto (nginx) para req.ip/rate-limit
TRUST_PROXY=1
AUTH_RATE_LIMIT_STORE=memory

# M20.2-A: en Docker el frontend lo sirve nginx; la API no monta estaticos.
# Fuera de Docker, true preserva el comportamiento historico.
SERVE_STATIC=true
AUTH_REGISTRATION_ENABLED=false
AUTH_BOOTSTRAP_ENABLED=false
# M21.8 — pool background (bg_role/BYPASSRLS) para scanner/scheduler/recovery.
# Debe apuntar al rol bg_role (creado en Fase 5). SIN fallback a DATABASE_URL:
# si falta, los flujos background fallan (fail-closed); el HTTP/app_role no la usa.
BG_DATABASE_URL=
SESSION_IDLE_SECONDS=1800
SCAN_SCHEDULER_TICK_MS=60000
SCAN_SCHEDULER_BATCH=5
# Hacer que `GET /api/healthz` compruebe la BD (fail-closed como readyz)
HEALTHCHECK_DB=true

# --- Frontend (servicio `web`) ---
WEB_PORT=8080
