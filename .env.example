# M12 — plantilla de entorno para `docker compose`. Copiar a `.env` y completar.
# NUNCA versionar valores reales: `.env` está en .gitignore/.dockerignore.

# --- PostgreSQL (servicio `db`) ---
POSTGRES_USER=privacy
# Superusuario `privacy` (rol de migraciones/provisioning). Generar con:
#   openssl rand -base64 48
POSTGRES_PASSWORD=
POSTGRES_DB=privacy

# --- Roles de aplicación (M22 P0-1) ---
# Contraseñas de app_role (HTTP) y bg_role (background). NUNCA hardcodeadas:
# la migración 0019 deja los roles con PASSWORD NULL y `db:provision-roles`
# (corre dentro del servicio `migrate`) las fija desde estas variables.
# Generar cada una con: openssl rand -base64 48
APP_ROLE_PASSWORD=
BG_ROLE_PASSWORD=

# --- Operaciones de backup (M25) ---
# Las consume `pnpm run ops:backup`; ninguna es leída por los servicios de Compose.
# Los valores por defecto entre paréntesis son los del código.
# BACKUP_DIR: obligatorio y debe quedar FUERA del repositorio (y del host Docker
#   en producción). Vacío hace fallar el backup; el repo solo se acepta con
#   ALLOW_LOCAL_BACKUP=1, reservado a un drill.
BACKUP_DIR=
# Días que se conservan los artefactos m24-postgres-*.
#
# M26.0: esto ya NO es la política de retención. La autoridad de retención es
# el lifecycle del almacenamiento off-host (90 días, ADR-003). Aquí solo queda
# una ventana de staging local: el tiempo suficiente para reintentar una subida
# fallida y para hacer un restore en el mismo host sin bajar nada.
#
# Se conserva el `find -mtime` a propósito. Borrarlo, como sugiere una lectura
# literal de ADR-002 D1, dejaría al backup sin copia local ante un fallo de red:
# el único juego de artefactos estaría en un bucket al que no se ha podido
# llegar. 3 días es el mínimo que cubre un fin de semana con el VPS inaccesible.
BACKUP_RETENTION_DAYS=3
# Segundos antes de considerar obsoleto un lock cuyo PID no se puede leer.
# Entero no negativo (120). 0 reclama de inmediato; un valor no numérico o
# negativo hace FALLAR el backup en lugar de degradarse en silencio.
BACKUP_LOCK_GRACE_SECONDS=120

# --- Almacenamiento off-host (M26.0 / ADR-003) ---
# Las consume `pnpm run ops:offhost-upload`. NINGUNA es leída por los servicios
# de Compose y aquí solo se documenta el FORMATO: los valores reales viven fuera
# del repositorio, en un archivo con modo 600 en el VPS.
#
# PENDIENTE hasta que exista el VPS de producción (aún no hay cuenta):
#   BACKUP_BUCKET         nombre propuesto: privaris-postgres-backups
#                         (los nombres B2 son únicos GLOBALES; la disponibilidad
#                         solo puede comprobarse creando la cuenta)
#   B2_S3_ENDPOINT        forma real: https://s3.<region>-<NNN>.backblazeb2.com
#                         el sufijo <NNN> es POR CUENTA y NO se deriva de la
#                         región; se lee del panel al crear la cuenta
#   B2_S3_REGION          región de firma SigV4; distinta del host del endpoint
#   B2_WRITE_KEY_ID       app key de escritura: listFiles + readFiles + writeFiles
#   B2_WRITE_SECRET_KEY   sin deleteFiles, sin bypassGovernance
#                         caduca a los 180 días (rotación en el runbook) y vive
#                         en un archivo 600 fuera del repositorio
#   B2_READ_KEY_ID        app key de SOLO LECTURA, prefijo prod/ únicamente
#   B2_READ_SECRET_KEY    NO reside en el VPS; se entrega fuera de banda
#
# SOURCE_ENCRYPTION_KEY NO aparece aquí ni debe almacenarse junto a estas
# credenciales: es un secreto de custodia separada (ADR-002 D2).
BACKUP_BUCKET=
B2_S3_ENDPOINT=
B2_S3_REGION=
B2_WRITE_KEY_ID=
B2_WRITE_SECRET_KEY=
B2_READ_KEY_ID=
B2_READ_SECRET_KEY=
# Prefijo de entorno bajo backups/ (prod | staging | drill). Un solo segmento.
BACKUP_PREFIX=prod
# Reintentos por objeto ante fallo remoto, y espera entre ellos. Un fallo
# persistente devuelve 76 (backup local correcto, subida fallida), nunca 1.
OFFHOST_UPLOAD_RETRIES=3
OFFHOST_UPLOAD_RETRY_DELAY_SECONDS=5

# --- Alertas del backup (M29.2 A2) ---
# La consumen dos scripts, ambos con el MISMO contrato:
#   scripts/ops/backup-schedule.sh  -> skipped_locked, failed
#   scripts/ops/offhost-upload.sh    -> partial_upload_failed (nace el 76)
# Sin esta variable NO hay alerta:
# el backup se comporta exactamente igual y el scheduler no falla. Es
# deliberadamente genérica: NO presupone Slack, SMTP, Discord, Telegram,
# Alertmanager ni ningún otro proveedor.
#
# Es un COMANDO. Recibe el evento en JSON por stdin, por ejemplo:
#   {"timestamp":"2026-10-01T02:17:00Z","result":"partial_upload_failed","exit_code":76}
# donde `result` es: ok | skipped_locked | partial_upload_failed | failed.
#
# Solo se invoca cuando `result` != "ok". Si el canal falla, el fallo queda
# registrado y el código de salida del backup NO cambia.
#
# NINGUNA es leída por los servicios de Compose.
ALERT_CMD=

# --- API (servicio `api`) ---
NODE_ENV=production
API_PORT=5000
# Generar con: openssl rand -base64 48
JWT_SECRET=
# >= 32 caracteres; cifra credenciales de fuentes (fail-fast en producción)
SOURCE_ENCRYPTION_KEY=
# Misma origin por defecto (nginx proxea /api). Solo definir si el frontend
# llama a la API desde otro origen.
CORS_ORIGINS=
# La API corre tras nginx/compose: confiar en un solo salto (nginx) para req.ip/rate-limit
TRUST_PROXY=1
AUTH_RATE_LIMIT_STORE=memory

# M20.2-A: en Docker el frontend lo sirve nginx; la API no monta estáticos.
# Fuera de Docker, true preserva el comportamiento histórico.
SERVE_STATIC=true
AUTH_REGISTRATION_ENABLED=false
# M21.8 — pool background (bg_role/BYPASSRLS) para scanner/scheduler/recovery.
# Debe apuntar al rol bg_role. SIN fallback a DATABASE_URL: si falta, los flujos
# background fallan (fail-closed); el HTTP/app_role no la usa.
BG_DATABASE_URL=
SESSION_IDLE_SECONDS=1800
SCAN_SCHEDULER_TICK_MS=60000
SCAN_SCHEDULER_BATCH=5
# Hacer que `GET /api/healthz` compruebe la BD (fail-closed como readyz)
HEALTHCHECK_DB=true

# --- Frontend (servicio `web`) ---
WEB_PORT=8080

# --- Provisioning del primer administrador (M22 P0-2, solo instalación nueva) ---
# Operación administrativa FUERA del flujo HTTP. Ejecutar UNA vez:
#   pnpm --filter @workspace/db run db:provision-admin
# Requiere ADMIN_DATABASE_URL (superusuario `privacy`) en el entorno.
ADMIN_DATABASE_URL=
PROVISION_ADMIN_EMAIL=
PROVISION_ADMIN_PASSWORD=
# Opcionales (defaults: nombre "Default Organization", slug derivado del nombre).
#PROVISION_ADMIN_NAME=
#PROVISION_ORG_NAME=
#PROVISION_ORG_SLUG=

# --- Recuperación de contraseña (M30.0/M31.0) --------------------------------
# M31.0: entrega real del enlace vía Resend (fetch nativo, sin dependencias).
# Sin RESEND_API_KEY ni PASSWORD_RESET_FROM no hay entrega y el endpoint sigue
# respondiendo 202 igual (no hay enumeración de cuentas).
# La API key es un SECRETO: proporciónala por entorno/gestor de secretos, nunca
# en este fichero con un valor real ni en git.
#RESEND_API_KEY=
# Remitente del correo (aceptado por Resend, p.ej. "Privaris <no-reply@example.com>").
#PASSWORD_RESET_FROM=
# Base del enlace. Si se define, se usa en lugar de derivarla de la petición
# (recomendado en producción detrás de un proxy).
#PASSWORD_RESET_BASE_URL=
