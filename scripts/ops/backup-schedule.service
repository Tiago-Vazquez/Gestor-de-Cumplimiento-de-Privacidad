# M29.2 A1 - Disparador periodico del backup de produccion.
#
# PLANTILLA, no se instala sola. Es el lado de INFRAESTRUCTURA: vive en el VPS,
# fuera del repositorio. El repositorio aporta el CONTRATO
# (scripts/ops/backup-schedule.sh -> scripts/ops/postgres-backup.sh).
#
# Instalar en el VPS:
#   sudo cp scripts/ops/backup-schedule.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now backup-schedule.timer
#   systemctl list-timers backup-schedule.timer
# Ejecucion manual:  sudo systemctl start backup-schedule.service
#
# Persistent=true: si el VPS estuvo apagado, systemd ejecuta el backup perdido al
# arrancar. Es lo correcto para un backup, y el lock de postgres-backup.sh evita
# solapes si la ejecucion tardia pisa a la programada.
[Unit]
Description=PostgreSQL logical backup (M29.2 A1)
Documentation=file:///opt/privaris/docs/operations-runbook.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Rutas absolutas y estables: el backup NO debe depender del cwd de quien lo llama.
WorkingDirectory=/opt/privaris
EnvironmentFile=/opt/privaris/.env
ExecStart=/opt/privaris/scripts/ops/backup-schedule.sh
# Si el backup tarda mas de 2h, se detiene. El backup parcial queda en disco y el
# siguiente run lo recoge; no se solapa porque el lock se libera al morir.
TimeoutStartSec=7200
# Codigos 75/76 son estados con significado propio: systemd los marca como fallo
# a proposito, porque backup-schedule.sh los propaga sin enmascararlos.
SuccessExitStatus=0